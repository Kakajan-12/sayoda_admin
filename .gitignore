# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
# отдельные папки сборки из NEXT_DIST_DIR — проверочные, в репозитории не нужны
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local

# vercel
.vercel

# рабочие копии claude code: внутри лежат отдельные git-репозитории, и без
# этой строки git записывает их в коммит как вложенные
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts

# настройки IDE: личные для каждого, а не часть проекта
.idea/

# заметки в markdown: в репозитории не нужны
# (уже отслеживаемые README.md, AGENTS.md и CLAUDE.md правило не затрагивает —
#  git продолжает следить за тем, что уже под его присмотром)
*.md
